[Unit]
Description=Prometheus Monitoring System
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vboxuser
WorkingDirectory=/home/vboxuser/Desktop/infrawatch/prometheus/prometheus-3.14.0.linux-amd64
ExecStart=/home/vboxuser/Desktop/infrawatch/prometheus/prometheus-3.14.0.linux-amd64/prometheus --config.file=/home/vboxuser/Desktop/infrawatch/prometheus/prometheus-3.14.0.linux-amd64/prometheus.yml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
